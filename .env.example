# Copy this file to .env and fill in your own keys. NEVER commit the real .env.

# Google AI Studio / Gemini API key (used for coordinators, synthesizer, layout, and Nano Banana image gen).
# If running on GCP with authenticated ADC, this can be left blank.
GEMINI_API_KEY=

# Council debaters (all optional — any missing/unfunded provider automatically falls back to Gemini).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MOONSHOT_API_KEY=

# Ideogram API key (primary comic image generator; falls back to Nano Banana / Pillow if absent).
IDEOGRAM_API_KEY=

# Public base URL of the deployed app (used for A2A loopback calls). Defaults to http://localhost:8000.
APP_URL=

# --- Optional MCP toolsets for the Illustrator (leave blank to use built-in tools) ---
# CHROME_MCP_COMMAND=
# CHROME_MCP_ARGS=
# IMAGE_MCP_COMMAND=
# IMAGE_MCP_ARGS=
# IMAGE_MCP_URL=
